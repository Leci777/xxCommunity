<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    数据库连接字符串。
    · 本机 SQL Server 默认实例 + Windows 身份验证（最常见的情况，装好就能用）：
        Data Source=. ; Initial Catalog=XiaoxinCommunityDB; Integrated Security=True
    · 如果用的是 SQL Server 身份验证（sa 账号），改成下面这样，把密码换成你自己的：
        Data Source=.; Initial Catalog=XiaoxinCommunityDB; User ID=sa; Password=你的密码;
    · 命名实例（例如 SQL Server Express）把 Data Source 写成：.\SQLEXPRESS
    · 也可以在程序登录页点“数据库设置”直接修改，保存后会写回本文件。
  -->
  <connectionStrings>
    <add name="XiaoxinDb"
         connectionString="Data Source=.;Initial Catalog=XiaoxinCommunityDB;Integrated Security=True;Connect Timeout=15;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
